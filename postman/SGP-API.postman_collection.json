              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type_statut_penal\": \"Détention provisoire\",\n    \"date_incarceration\": \"2026-01-10\",\n    \"autorite_signataire\": \"Procureur de la République\",\n    \"motif_detention\": \"Vol qualifié\",\n    \"type_mandat\": \"Mandat de dépôt\",\n    \"reference_mandat\": \"REF-2026-001\",\n    \"date_signature_mandat\": \"2026-01-10\",\n    \"date_expiration_mandat\": \"2026-04-10\",\n    \"objets_personnels\": \"Montre, téléphone\",\n    \"autorite_penitentiaire\": \"Régisseur\",\n    \"etat_physique_arrivee\": \"Bon état\"\n}"
